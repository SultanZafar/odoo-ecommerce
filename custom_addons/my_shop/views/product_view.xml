<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_featured" model="ir.ui.view">
        <field name="name">product.template.form.featured</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="before">
                <field name="is_featured" string="Featured Product"/>
            </xpath>
        </field>
    </record>

    <record id="website_sale_featured_badge" model="ir.ui.view">
        <field name="name">website.sale.featured.badge</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.products_item"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="before">
                <t t-if="product.is_featured">
                    <div class="text-center mb-1">
                        <span class="badge bg-warning text-dark">
                            ⭐ Featured
                        </span>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

</odoo>